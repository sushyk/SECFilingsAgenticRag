{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AI": {
    "Chat": { "Model": "qwen3:4b", "ContextLength": 8192, "TimeoutSeconds": 600 },
    "Embedding": { "Model": "nomic-embed-text" }
  },
  "Telemetry": {
    "EnableSensitiveData": false
  },
  "Retrieval": {
    "Strategy": "Vector",
    "DefaultTop": 5,
    "MaxTop": 20,
    "ExcludeInstructionLikeChunks": true
  },
  "Mcp": {
    "MaxResourceTokens": 6000
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
