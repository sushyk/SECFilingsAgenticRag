{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AI": {
    "Chat": { "Model": "qwen3:4b", "ContextLength": 8192, "TimeoutSeconds": 600 },
    "Embedding": { "Model": "nomic-embed-text" }
  },
  "Telemetry": {
    "EnableSensitiveData": false
  },
  "Retrieval": {
    "Strategy": "Vector",
    "DefaultTop": 5,
    "MaxTop": 20,
    "ExcludeInstructionLikeChunks": true
  },
  "Agent": {
    "RetrievalTop": 5,
    "RecentMessageMemoryLimit": 4,
    "MaxToolIterations": 6,
    "MaxInputTokens": 1000,
    "MaxExcerptTokens": 512,
    "SessionStore": "Postgres",
    "CompactAboveTokens": 4000,
    "MaxHistoryTurns": 10,
    "HardTokenBudget": 6000
  },
  "Guardrails": {
    "TopicGuard": { "Enabled": true, "Model": null },
    "RequireCitations": true
  },
  "Mcp": {
    "Endpoint": "http://filings-mcp-server/mcp",
    "TimeoutSeconds": 120
  },
  "Api": {
    "ChatTimeoutSeconds": 900,
    "MaxRequestBytes": 65536
  },
  "RateLimiting": {
    "Chat": { "PermitLimit": 30, "WindowSeconds": 60 }
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
