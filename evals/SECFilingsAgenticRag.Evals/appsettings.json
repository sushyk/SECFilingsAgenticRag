{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "ConnectionStrings": {
    "ollama": "http://localhost:11434"
  },
  "AI": {
    "Chat": { "Model": "qwen3:4b", "ContextLength": 8192 },
    "Embedding": { "Model": "nomic-embed-text" }
  },
  "Telemetry": {
    "EnableSensitiveData": false
  },
  "Retrieval": {
    "Strategy": "Vector",
    "DefaultTop": 5,
    "MaxTop": 20,
    "ExcludeInstructionLikeChunks": true,
    "Rerank": { "Enabled": false, "CandidatePool": 20, "Model": null },
    "MultiQuery": { "Enabled": false, "Variants": 3, "Model": null },
    "Hybrid": { "CandidatePool": 40, "RrfK": 60 }
  },
  "Agent": {
    "RetrievalTop": 5,
    "RecentMessageMemoryLimit": 4,
    "MaxToolIterations": 6
  },
  "Mcp": {
    "Endpoint": "http://localhost:5190/mcp",
    "TimeoutSeconds": 120
  },
  "Evals": {
    "DatasetPath": "datasets/golden.json",
    "ResultsPath": "../../evals/results",
    "Judge": {
      "Provider": "OpenAICompatible",
      "Model": "gpt-4o-mini",
      "Endpoint": "https://models.github.ai/inference",
      "TimeoutSeconds": 300
    }
  }
}
